# Private key for deployment (DO NOT commit actual .env file)
PRIVATE_KEY=your_private_key_here

# RPC URLs
# Zama fhEVM is deployed on Sepolia testnet (Chain ID: 11155111)
SEPOLIA_RPC_URL=https://rpc.sepolia.org

# Zama fhEVM Relayer URL (for relayer operations)
RELAYER_URL=https://relayer.testnet.zama.cloud

# Etherscan API key for verification
ETHERSCAN_API_KEY=your_etherscan_api_key

# Zama fhEVM Contract Addresses on Sepolia (Chain ID: 11155111)
# Source: https://docs.zama.org/protocol/solidity-guides/smart-contract/configure/contract_addresses

# FHEVM Host Chain Contracts (Sepolia)
FHEVM_EXECUTOR_CONTRACT=0x848B0066793BcC60346Da1F49049357399B8D595
ACL_CONTRACT=0x687820221192C5B662b25367F70076A37bc79b6c
HCU_LIMIT_CONTRACT=0x594BB474275918AF9609814E68C61B1587c5F838
KMS_VERIFIER_CONTRACT=0x1364cBBf2cDF5032C47d8226a6f6FBD2AFCDacAC
INPUT_VERIFIER_CONTRACT=0xbc91f3daD1A5F19F8390c400196e58073B6a0BC4
DECRYPTION_ORACLE_CONTRACT=0xa02Cda4Ca3a71D7C46997716F4283aa851C28812

# Gateway Chain Contracts (Chain ID: 55815)
GATEWAY_DECRYPTION_ADDRESS=0xb6E160B1ff80D67Bfe90A85eE06Ce0A2613607D1
GATEWAY_INPUT_VERIFICATION_ADDRESS=0x7048C39f048125eDa9d678AEbaDfB22F7900a29F

# Gas reporting
REPORT_GAS=false

# FHE Mode (true for fast testing, false for real FHE)
FHEVM_MOCKED=true
