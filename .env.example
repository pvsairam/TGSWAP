# Private key for deployment (DO NOT commit actual .env file)
PRIVATE_KEY=your_private_key_here

# RPC URLs
ZAMA_RPC_URL=https://devnet.zama.ai
SEPOLIA_RPC_URL=https://rpc.sepolia.org

# Etherscan API key for verification
ETHERSCAN_API_KEY=your_etherscan_api_key

# Gateway and ACL addresses (Zama devnet)
GATEWAY_ADDRESS=0x33347831500F1e73f102dB1e4850F26FEc708a62
ACL_ADDRESS=0xFee8407e2f5e3Ee68ad77cAE98c434e637f516e5

# Gas reporting
REPORT_GAS=false

# FHE Mode (true for fast testing, false for real FHE)
FHEVM_MOCKED=true
